# Cloudinary Credentials (Required for signed uploads and custom cloud account)
# If left empty, the application uses Cloudinary's public demo cloud transformations with verified assets.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Resend Transactional Email Delivery (Optional - for live postcard dispatch)
# If not configured, the Postal Bureau will notify the sender that email delivery is unconfigured.
RESEND_API_KEY=
RESEND_FROM_EMAIL=ROOTS Postal Bureau <onboarding@resend.dev>

